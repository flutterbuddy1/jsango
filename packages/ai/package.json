    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@jsango/runtime": "workspace:^",
    "@jsango/core": "workspace:^",
    "@jsango/container": "workspace:^",
    "@jsango/config": "workspace:^",
