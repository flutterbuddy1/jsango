{
  "name": "@jsango/websocket",
  "version": "1.0.0",
  "description": "WebSocket server abstraction, rooms, broadcasting, and Node adapter for jsango",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/public/testing/index.d.ts",
      "import": "./dist/public/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@jsango/core": "workspace:*",
    "@jsango/http": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flutterbuddy1/jsango.git",
    "directory": "packages/websocket"
  },
  "publishConfig": {
    "access": "public"
  }
}
