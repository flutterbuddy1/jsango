{
  "name": "@django-js/events",
  "version": "1.0.0",
  "description": "Typed event bus, handlers, middleware, and queue integration for django-js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/public/testing/index.d.ts",
      "import": "./dist/public/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@django-js/core": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/django-js/django-js.git",
    "directory": "packages/events"
  },
  "publishConfig": {
    "access": "public"
  }
}
