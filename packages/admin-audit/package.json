{
  "name": "@jsango/admin-audit",
  "version": "1.1.1",
  "description": "Structured audit log for jsango Admin — records every create, update, delete, and action",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@jsango/core": "workspace:^",
    "@jsango/admin-core": "workspace:^"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flutterbuddy1/jsango.git",
    "directory": "packages/admin-audit"
  },
  "publishConfig": {
    "access": "public"
  }
}
