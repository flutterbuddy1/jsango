{
  "name": "@jsango/openapi",
  "version": "1.0.0",
  "description": "Deterministic OpenAPI 3.x document generation and documentation foundation for jsango",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@jsango/core": "workspace:*",
    "@jsango/http": "workspace:*",
    "@jsango/router": "workspace:*",
    "@jsango/validation": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsango/jsango.git",
    "directory": "packages/openapi"
  },
  "publishConfig": {
    "access": "public"
  }
}
