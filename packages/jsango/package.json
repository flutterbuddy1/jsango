{
  "name": "jsango",
  "version": "1.0.9",
  "description": "Production-grade, batteries-included TypeScript backend framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jsango": "./dist/bin/jsango.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@jsango/runtime": "workspace:^",
    "@jsango/core": "workspace:^",
    "@jsango/container": "workspace:^",
    "@jsango/config": "workspace:^",
    "@jsango/http": "workspace:^",
    "@jsango/router": "workspace:^",
    "@jsango/middleware": "workspace:^",
    "@jsango/validation": "workspace:^",
    "@jsango/database": "workspace:^",
    "@jsango/orm": "workspace:^",
    "@jsango/migrations": "workspace:^",
    "@jsango/auth": "workspace:^",
    "@jsango/websocket": "workspace:^",
    "@jsango/events": "workspace:^",
    "@jsango/queue": "workspace:^",
    "@jsango/cache": "workspace:^",
    "@jsango/openapi": "workspace:^",
    "@jsango/observability": "workspace:^",
    "@jsango/ai": "workspace:^",
    "@jsango/admin-core": "workspace:^",
    "@jsango/admin-auth": "workspace:^",
    "@jsango/admin-audit": "workspace:^",
    "@jsango/admin-server": "workspace:^",
    "@jsango/admin-ui": "workspace:^",
    "@jsango/cli": "workspace:^",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flutterbuddy1/jsango.git",
    "directory": "packages/jsango"
  },
  "publishConfig": {
    "access": "public"
  }
}
