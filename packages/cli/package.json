{
  "name": "@django-js/cli",
  "version": "1.0.0",
  "description": "CLI commands and project/code generation for django-js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "django-js": "./dist/bin/django-js.js",
    "nexora": "./dist/bin/django-js.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@django-js/runtime": "workspace:*",
    "@django-js/core": "workspace:*",
    "@django-js/container": "workspace:*",
    "@django-js/config": "workspace:*",
    "@django-js/http": "workspace:*",
    "@django-js/router": "workspace:*",
    "@django-js/middleware": "workspace:*",
    "@django-js/database": "workspace:*",
    "@django-js/orm": "workspace:*",
    "@django-js/migrations": "workspace:*",
    "@django-js/cache": "workspace:*",
    "@django-js/queue": "workspace:*",
    "@django-js/events": "workspace:*",
    "@django-js/websocket": "workspace:*",
    "@django-js/openapi": "workspace:*",
    "@django-js/observability": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/django-js/django-js.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
