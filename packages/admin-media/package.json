{
  "name": "@django-js/admin-media",
  "version": "0.0.1",
  "description": "File and image upload handling for django-js Admin — storage drivers and media management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@django-js/core": "workspace:*",
    "@django-js/admin-core": "workspace:*"
  },
  "files": [
    "dist"
  ]
}
