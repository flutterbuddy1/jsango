# Copy to .env and fill in what your chosen models need. Nothing here is required for the tests.

# development: detailed errors, admin with a dev password, transcripts in the admin.
# Leave it out (or anything else) for production behaviour.
NODE_ENV=development

# LLM: openai (default) | anthropic | ollama
LLM=openai
# LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# VOICE: openai (default) | deepgram-cartesia | elevenlabs | local | realtime | gemini
VOICE=openai
# VOICE_NAME=marin
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=
# Self-hosted (VOICE=local): any OpenAI-compatible speech servers
# LOCAL_STT_URL=http://localhost:8000/v1
# LOCAL_TTS_URL=http://localhost:8880/v1

# Record calls to ./recordings (tell your callers): 1 to enable
RECORD=0

# Phone line (optional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_NUMBER=+15550001111
# PUBLIC_URL=https://your-tunnel.example.com

# Admin (/admin). In production ADMIN_PASSWORD is required, or the admin is not mounted.
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
