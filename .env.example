# ==============================================================================
# django-js Framework — Production Environment Configuration (.env.example)
# ==============================================================================

# Application Runtime
NODE_ENV=production
APP_NAME=django-js-app
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0

# Security & Secrets (Must be set to high-entropy strings in production)
APP_KEY=base64:your-32-byte-secret-key-here-must-be-random
JWT_SECRET=your-secure-jwt-secret-key-here
JWT_EXPIRATION_SECONDS=3600
SESSION_SECRET=your-secure-session-secret-here
SESSION_LIFETIME_SECONDS=86400

# Database Configuration
DB_CONNECTION=default
DB_DRIVER=memory # Options: postgres, sqlite, memory
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=django_js_production
DB_USERNAME=postgres
DB_PASSWORD=secret_db_password
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_ACQUIRE_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

# Cache Configuration
CACHE_DRIVER=memory # Options: memory, redis
CACHE_DEFAULT_TTL_MS=300000
CACHE_PREFIX=djs_cache

# Queue & Background Jobs
QUEUE_DRIVER=memory # Options: memory, database, redis
QUEUE_WORKER_CONCURRENCY=4
QUEUE_POLLING_INTERVAL_MS=1000
QUEUE_LEASE_TIMEOUT_MS=60000

# Real-Time & WebSockets
WS_ENABLED=true
WS_HEARTBEAT_INTERVAL_MS=30000
WS_HEARTBEAT_TIMEOUT_MS=60000
WS_MAX_CONNECTIONS=10000
WS_MAX_ROOMS_PER_CONNECTION=50

# Admin Platform
ADMIN_ENABLED=true
ADMIN_PREFIX=/admin
ADMIN_SESSION_TTL_MS=86400000

# OpenAPI Documentation
OPENAPI_ENABLED=true
OPENAPI_PATH=/openapi.json
OPENAPI_DOCS_PATH=/docs

# Observability & Telemetry
LOG_LEVEL=info # Options: debug, info, warn, error, fatal
LOG_FORMAT=json # Options: json, text
METRICS_ENABLED=true
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=0.1
