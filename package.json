{
  "name": "jsango-monorepo",
  "version": "1.6.0",
  "private": true,
  "description": "Production-grade, batteries-included TypeScript backend framework for modern JavaScript runtimes",
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yaml,yml}\"",
    "check:branding": "node scripts/check-branding.mjs",
    "clean": "turbo run clean",
    "bench:compare": "node benchmarks/compare/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "autocannon": "8.0.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.21.0",
    "express": "5.2.1",
    "fastify": "5.12.5",
    "jsango": "workspace:*",
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^11.3.0",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
